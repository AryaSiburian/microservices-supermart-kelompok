# Database Configuration
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=nusantara_db
MYSQL_USER=nusantara_user
MYSQL_PASSWORD=nusantara_secret
MYSQL_ROOT_PASSWORD=root_secret

# Application Configuration
APP_ENV=development
APP_PORT=3000
FRONTEND_PORT=4200

# Order calls the standalone Inventory provider over a persistent gRPC channel.
INVENTORY_GRPC_TARGET=127.0.0.1:50051
INVENTORY_GRPC_ADDR=127.0.0.1:50051
INVENTORY_REST_ADDR=127.0.0.1:8081

# Security Configuration
JWT_SECRET=supermart-secret-key-for-nusantara-course-2026
JWT_EXPIRY=24h
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3000
